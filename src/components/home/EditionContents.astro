---
import { sortPhotos } from '../../lib/photos.ts';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import archiveAnalytics from '../../data/archive-analytics.json';
import RandomPortraits from '../people/RandomPortraits.astro';
import { chapters } from '../../lib/chapters.ts';
import { localePath, type Locale } from '../../lib/locale.ts';
import { url } from '../../lib/url.ts';
import facultyOne from '../../assets/portraits/jin-sung-kim.jpg';
import facultyTwo from '../../assets/portraits/dong-wook-kim.jpg';
import facultyThree from '../../assets/portraits/hojin-kim.jpg';
import publicationsImage from '../../assets/chapters/publications.jpg';
import patentsImage from '../../assets/chapters/patents.jpg';
import conferencesImage from '../../assets/chapters/conferences.jpg';
import fundingImage from '../../assets/chapters/funding.png';
import awardsImage from '../../assets/chapters/awards.jpg';

interface Props {
  locale: Locale;
  counts: { faculty: number; photos: number; students: number; alumni: number; papers: number; patents: number; presentations: number; awards: number };
  years: Array<{ year: number; papers: number }>;
}
const { locale, counts, years } = Astro.props;
const members=await getCollection('members');
const seminars=await getCollection('seminars');
const comments=(await getCollection('comments')).sort((a,b)=>a.id.localeCompare(b.id));
const albums = new Set<string>();
const photos = sortPhotos(await getCollection('photos')).filter((photo) => {
  const album = photo.data.date + ':' + photo.data.caption;
  if (albums.has(album)) return false;
  albums.add(album);
  return true;
}).slice(0, 3);
const ko = locale === 'ko';
const previews = [
  { value: '2016–2026', text: ko ? '해마다 쌓인 발견과 성장의 기록' : 'A year-by-year record of discovery and growth' },
  { value: String(counts.faculty), text: ko ? '연구의 방향을 함께 만들어가는 교수진' : 'The faculty guiding our shared research journey' },
  { value: String(counts.students), text: ko ? '오늘의 연구를 만들어가는 사람들' : 'The people shaping research today' },
  { value: String(counts.alumni), text: ko ? '연구실을 넘어 이어지는 우리의 여정' : 'A shared journey that continues beyond the lab' },
  { value: String(counts.papers), text: ko ? '논문으로 이어진 연구의 궤적' : 'A research journey told through publications' },
  { value: String(counts.patents), text: ko ? '연구에서 기술로 이어지는 아이디어' : 'Ideas that connect research and technology' },
  { value: String(counts.presentations), text: ko ? '세계의 연구자들과 나눈 발견' : 'Discoveries shared with the research community' },
  { value: String(counts.awards), text: ko ? '함께 이룬 성취의 순간들' : 'Moments of achievement, made together' },
  { value: (archiveAnalytics.funding.tot.a/1e8).toFixed(1), text: ko?'연구를 가능하게 한 지원 · 억원':'Funding discovery · KRW 100M' },
  { value: String(seminars.length), text: ko?'연구와 생각을 함께 나눈 랩세미나':'Research and ideas shared in lab seminars' },
  { value: counts.photos ? String(counts.photos) : '2016–2026', text: ko ? '사진으로 돌아보는 연구실의 순간들' : 'Our shared moments, remembered in photographs' },
  { value: String(comments.length), text: ko ? '교수진과 졸업생이 전하는 기억과 응원' : 'Memories and wishes from faculty and alumni' },
];
// Topic illustrations are generated imagery, identified separately from the real member photographs.
const chapterVisuals = [
  { image: publicationsImage, alt: ko ? '의료영상 연구 학술지와 논문을 표현한 이미지' : 'An open journal illustrating medical imaging research publications' },
  { image: patentsImage, alt: ko ? '기술 도면과 의료공학 시제품을 표현한 이미지' : 'An engineering prototype and technical drawings illustrating patents' },
  { image: conferencesImage, alt: ko ? '의료영상 발표 화면이 있는 학술대회장을 표현한 이미지' : 'A scientific conference auditorium with a medical imaging presentation' },
  { image: awardsImage, alt: ko ? '연구 성과의 수상을 표현한 크리스털 트로피 이미지' : 'A crystal trophy illustrating research achievement awards' },
];
const facultyPortraits = [facultyOne, facultyTwo, facultyThree];
const largestYear = Math.max(1, ...years.map((year) => year.papers));
const paperTotal = years.reduce((total, year) => total + year.papers, 0);
---

<div class="contents-spread">
<section id="edition-contents" class="wrap edition-contents" aria-labelledby="contents-heading">
  <div class="contents-story">
    <p class="edition-eyebrow" lang="en">THE ANNIVERSARY EDITION</p>
    <h2 id="contents-heading" lang="en">Our journey.<br />Our people.<br /><em>Our future.</em></h2>
    <div class="contents-previews" aria-live="polite" aria-atomic="true">
      {chapters.map((chapter, i) => (
        <figure class="contents-preview" data-preview={i} hidden={i !== 0}>
          {i === 0 ? (
            <div class="contents-chart">
              <div class="mini-chart-heading">
                <div>
                  <p>{ko ? '논문으로 쌓인 10년' : 'A decade in publications'}</p>
                  <strong>{paperTotal}<small>{ko ? '편' : 'papers'}</small></strong>
                </div>
                <span>{ko ? '연간 최다' : 'Annual high'}<b>{largestYear}</b></span>
              </div>
              <div class="contents-chart-bars">
                {years.map((year) => (
                  <div class:list={['mini-chart-year', { 'is-peak': year.papers === largestYear }]}
                    title={String(year.year) + ' · ' + (ko ? '논문' : 'Papers') + ' ' + year.papers}>
                    <span class="mini-bar" style={'--height:' + year.papers / largestYear * 100 + '%'}>
                      <span class="mini-bar-value">{year.papers}</span>
                    </span>
                    <span class="mini-year">{String(year.year).slice(2)}</span>
                  </div>
                ))}
              </div>
              <p class="contents-chart-label">{ko ? '연도별 논문 수 · 2016–2026' : 'Papers per year · 2016–2026'}</p>
            </div>
          ) : i === 1 ? (
            <div class="contents-portraits">{facultyPortraits.map(portrait=><Image src={portrait} alt="" width={180} height={240} fit="cover" loading="lazy" />)}</div>
          ) : i === 2 || i === 3 ? (
            <RandomPortraits members={members.filter(m=>m.data.role===(i===2?'student':'alumni'))} className="contents-portraits" poolKey={i===2?'students-contents':'alumni-contents'} />
          ) : chapter.path === '/projects/' ? (
            <Image class="contents-science" src={fundingImage} alt={ko?'의료영상 연구 제안서와 연구 장비를 표현한 이미지':'Medical imaging research proposals and laboratory equipment'} width={1100} height={550} fit="cover" loading="eager" />
          ) : chapter.path === '/activity/seminars/' ? (
            <Image class="contents-science" src={conferencesImage} alt={ko?'연구 발표와 토론을 표현한 이미지':'Research presentations and discussion'} width={1100} height={550} fit="cover" loading="eager" />
          ) : chapter.path === '/archive/comments/' ? (
            <div class="contents-letters"><p>VOICES / MPBEL</p><strong>{ko?'함께 쓴 10년.':'Ten years, together.'}</strong>{comments[0] && <blockquote lang="ko">{comments[0].body?.trim().slice(0,145)}…<cite>{comments[0].data.name}</cite></blockquote>}</div>
          ) : chapter.path === '/archive/photos/' ? (
            <div class="contents-photo-index">
              <p class="photo-index-label">MPBEL / PHOTO ARCHIVE</p>
              {photos.length > 0 ? <div class="contents-portraits">{photos.map((photo) => <img src={/^https:\/\//.test(photo.data.image) ? photo.data.image : url(photo.data.thumbnail ?? photo.data.image)} alt={photo.data.caption ?? ''} loading="lazy" />)}</div> : <>
                <strong>Shared<br /><em>moments.</em></strong>
                <div class="photo-index-topics"><span>{ko ? '학회' : 'Conferences'}</span><span>{ko ? '연구실 일상' : 'Lab life'}</span><span>{ko ? '졸업' : 'Graduation'}</span></div>
                <p class="photo-index-note">{ko ? '사진 앨범 준비 중' : 'Photo albums coming soon'}</p>
              </>}
            </div>
          ) : (
            <Image class="contents-science" src={chapterVisuals[i - 4].image}
              alt={chapterVisuals[i - 4].alt} width={1100} height={550} fit="cover" loading="eager" />
          )}
          <figcaption>
            <div><strong>{previews[i].value}</strong><span>{ko ? chapter.ko : chapter.title}</span></div>
            <p>{previews[i].text}</p>
            {((i >= 4 && i <= 7) || chapter.path==='/projects/' || chapter.path==='/activity/seminars/') && <p class="contents-image-credit">{ko ? '주제 이미지 · AI 생성' : 'Topic image · AI generated'}</p>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
  <nav class="contents-chapters" aria-label={ko ? '10주년 목차' : 'Anniversary contents'}>
    <ul>
      {chapters.map((chapter, i) => (
        <li>
          <a class:list={['contents-chapter', { 'is-active': i === 0 }]} data-chapter={i}
            href={chapter.path === '/years/' ? '#history' : url(localePath(chapter.path, locale))}>
            <span lang="en">{chapter.title}</span>
            {ko && <small>{chapter.ko}</small>}
          </a>
        </li>
      ))}
    </ul>
    <p class="contents-footnote">{ko ? '연세 의학물리 및 의공학 연구실의 10년을 펼쳐보세요.' : 'Explore ten years of the Yonsei Medical Physics and Biomedical Engineering Lab.'}</p>
  </nav>
</section>
</div>

<script>
  import { refreshPortraits } from '../../scripts/random-portraits.ts';
  const contents = document.getElementById('edition-contents');
  if (contents) {
    const links = contents.querySelectorAll<HTMLAnchorElement>('[data-chapter]');
    const previews = contents.querySelectorAll<HTMLElement>('[data-preview]');
    const show = (index: string | undefined) => {
      links.forEach((link) => link.classList.toggle('is-active', link.dataset.chapter === index));
      previews.forEach((preview) => { const wasHidden=preview.hidden; preview.hidden = preview.dataset.preview !== index; if(wasHidden && !preview.hidden){const portraits=preview.querySelector<HTMLElement>('[data-random-portraits]');if(portraits)refreshPortraits(portraits);} });
    };
    links.forEach((link) => {
      link.addEventListener('pointerenter', () => show(link.dataset.chapter));
      link.addEventListener('focus', () => show(link.dataset.chapter));
    });
  }
</script>
