---
// An annual chart with a selectable research metric. Year links reveal the corresponding record panel.
// The chart scrolls horizontally on narrow screens and keeps ordinary year-page links without JavaScript.
import MemberTimeline from '../people/MemberTimeline.astro';
import type { Locale } from '../../lib/locale.ts';
import { YEARS, barHeights } from '../../lib/years.ts';
import { t } from '../../i18n/index.ts';

type Person = { name: string; lang?: string };

interface Props {
  years: Array<{
    year: number;
    href: string;
    papers: number;
    presentations: number;
    awards: number;
    /** Projects running in the year. */
    projects: number;
    /** The first few who joined, earliest first. */
    joined: Person[];
    /** How many more joined than are shown. */
    joinedMore: number;
    degrees: Person[];
  }>;
  /** The year shown when the page loads. */
  selected: number;
  locale: Locale;
}

const { years, selected, locale } = Astro.props;
const s = t(locale);
const tl = s.timeline;
const range = `${YEARS[0]} – ${YEARS[YEARS.length - 1]}`;
const SERIES = ['papers', 'presentations', 'awards'] as const;
type Series = (typeof SERIES)[number];
const steps = { papers: 10, presentations: 20, awards: 5 };
const totals = Object.fromEntries(SERIES.map((key) => [key, years.reduce((n, year) => n + year[key], 0)]));

function scaleFor(key: Series) {
  const values = years.map((year) => year[key]);
  const step = steps[key];
  const maximum = Math.max(step, Math.ceil(Math.max(0, ...values) / step) * step);
  const ticks = Array.from({ length: maximum / step + 1 }, (_, i) => maximum - i * step);
  return { ticks, heights: barHeights(values, 180, maximum) };
}
const scales = {
  papers: scaleFor('papers'),
  presentations: scaleFor('presentations'),
  awards: scaleFor('awards'),
};
// A column is 1/11 of 1200px. Korean labels fit two counts to a line (`논문 25 · 발표 67`) and several names to a
// line; English labels and names do not, so English pages give each count and each name its own line.
const stacked = locale === 'en';
/** The four counts of a year as lines of text: two per line in Korean, one per line in English. */
const numLines = (y: Props['years'][number]) => {
  const items = [
    `${tl.short.papers} ${y.papers}`,
    `${tl.short.presentations} ${y.presentations}`,
    `${tl.short.awards} ${y.awards}`,
    `${tl.short.projects} ${y.projects}`,
  ];
  return stacked ? items : [items.slice(0, 2).join(' · '), items.slice(2).join(' · ')];
};
---

<section id="history" class="wrap timeline" data-series="papers" style={'--chart-intervals:' + (scales.papers.ticks.length - 1)} aria-labelledby="timeline-title">
  <div class="timeline-head">
    <h2 class="timeline-title" id="timeline-title">{tl.title} <span>{range}</span></h2>
  </div>
  <details class="home-member-timeline">
    <summary>{locale==='ko'?'멤버 타임라인':'Member timeline'}<span>{locale==='ko'?'함께한 시간 보기':'Explore our time together'}</span></summary>
    <MemberTimeline locale={locale} />
  </details>
  <div class="timeline-series" role="group" aria-label={locale === 'ko' ? '그래프 항목 선택' : 'Chart metric'}>
    {SERIES.map((key) => (
      <button type="button" data-chart-series={key} data-ticks={scales[key].ticks.join(',')} aria-controls="timeline-plot" aria-pressed={key === 'papers'}>
        <span>{tl[key]}</span><strong>{totals[key]}</strong>
      </button>
    ))}
  </div>
  <div class="timeline-chart">
    <div class="chart-scale" aria-hidden="true">
      {scales.papers.ticks.map((tick, i) => <span style={'top:' + i / (scales.papers.ticks.length - 1) * 100 + '%'}>{tick}</span>)}
    </div>
    <div class="timeline-scroll" id="timeline-plot" role="region" aria-label={locale === 'ko' ? '연도별 연구 실적 그래프' : 'Annual research output chart'} tabindex="0">
    <ol class="timeline-years">
    {
      years.map((y, yearIndex) => (
        <li>
          <a
            href={y.href}
            data-year={y.year}
            aria-controls={'year-records-' + y.year}
            class={y.year === selected ? 'on' : undefined}
            aria-current={y.year === selected ? 'true' : undefined}
          >
            <span class="tl-year">{y.year}</span>
            <span class="tl-figs">
              <span class="tl-bars" aria-hidden="true">
                {SERIES.map((k) => (
                  <i class={`bar-${k}`} data-count={y[k]} style={'--bar:' + scales[k].heights[yearIndex]} />
                ))}
              </span>
              <span class="tl-nums">
                {numLines(y).map((line) => (
                  <span>{line}</span>
                ))}
              </span>
            </span>
            <span class="tl-people">
              <span class="tl-join">
                <span class="tl-label">{tl.joined}</span>
                {y.joined.length === 0 ? (
                  <span class="tl-none">{s.noRecords}</span>
                ) : (
                  <span class={stacked ? 'tl-names stacked' : 'tl-names'}>
                    {y.joined.map((p) => (
                      <span class="tl-name" lang={p.lang}>
                        {p.name}
                      </span>
                    ))}
                    {y.joinedMore > 0 && <span class="tl-more">+{y.joinedMore}</span>}
                  </span>
                )}
              </span>
              {y.degrees.length > 0 && (
                <span class="tl-degrees">
                  {y.degrees.map((p) => (
                    <span class="chip" lang={p.lang}>
                      {p.name}
                    </span>
                  ))}
                </span>
              )}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
    </div>
  </div>
  <slot />
</section>

<script>
  import '../../scripts/year-panel.ts';
</script>
