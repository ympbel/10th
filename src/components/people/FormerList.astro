---
import type { CollectionEntry } from 'astro:content';
import MemberLink from './MemberLink.astro';
import { displayName } from '../../lib/people.ts';
import type { Locale } from '../../lib/locale.ts';

interface Props {
  members: CollectionEntry<'members'>[];
  locale: Locale;
}
const { members, locale } = Astro.props;
---

<ol class="former-list historical-roster">
  {members.map((member, index) => (
    <li data-member={member.id}>
      <span class="roster-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <MemberLink id={member.id} name={displayName(member.data, locale)} locale={locale} />
    </li>
  ))}
</ol>
