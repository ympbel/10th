---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../../lib/locale';
const { locale } = Astro.props as { locale: Locale };
const photos = Object.entries(import.meta.glob<{ default: ImageMetadata }>('../../assets/faculty-moments/*.jpeg', { eager: true })).sort(([a],[b])=>a.localeCompare(b)).map(([,p])=>p.default);
// Open with the original group portrait at Gwanghyewon.
const initialPhoto = 2;
const title = locale === 'ko' ? '함께한 순간들' : 'Moments together';
---
<section class="faculty-moments" aria-label={title}>
  <div class="faculty-moments-heading"><h2>{title}</h2><span>MPBEL · FACULTY</span></div>
  <div class="faculty-moments-canvas" role="group" aria-label={locale==='ko'?'사진 선택':'Choose a photo'}>
    {photos.map((photo,index)=><button type="button" class="floating-photo" data-moment-select={index} data-slot={(index-initialPhoto+photos.length)%photos.length} aria-pressed={index===initialPhoto} aria-label={locale==='ko'?`${index+1}번째 사진 보기`:`View photo ${index+1}`}><Image src={photo} width={1200} alt={locale==='ko'?`교수진의 함께한 순간 ${index+1}`:`Faculty moment ${index+1}`} loading={index===initialPhoto?'eager':'lazy'} /></button>)}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.faculty-moments').forEach(gallery=>{
    const buttons=Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-moment-select]'));
    buttons.forEach((button,index)=>button.addEventListener('click',()=>{
      buttons.forEach((item,itemIndex)=>{
        item.setAttribute('aria-pressed',String(item===button));
        item.dataset.slot=String((itemIndex-index+buttons.length)%buttons.length);
      });
    }));
  });
</script>
<style>
.faculty-moments{margin:0 0 56px;padding-top:12px;}
.faculty-moments-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:12px;}
.faculty-moments-heading h2{font-size:20px;font-weight:500;color:var(--text-primary);margin:0;}
.faculty-moments-heading span{font-size:12px;letter-spacing:.12em;color:var(--text-secondary);}
.faculty-moments-canvas{position:relative;isolation:isolate;height:540px;perspective:1200px;}
.floating-photo{position:absolute;left:var(--x);top:var(--y);width:21%;padding:0;border:0;background:none;cursor:pointer;transform:translate(-50%,-50%) rotate(var(--r));z-index:2;opacity:.78;transition:left .7s cubic-bezier(.22,.8,.25,1),top .7s cubic-bezier(.22,.8,.25,1),width .7s cubic-bezier(.22,.8,.25,1),transform .7s cubic-bezier(.22,.8,.25,1),opacity .4s;}
.floating-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;object-position:center 65%;border-radius:3px;box-shadow:0 18px 35px -12px #0007;transition:box-shadow .4s;}
.floating-photo[data-slot="0"]{--x:50%;--y:50%;--r:-1deg;width:57%;z-index:10;opacity:1;}
.floating-photo[data-slot="0"] img{width:auto;max-width:100%;max-height:370px;margin:auto;aspect-ratio:auto;box-shadow:0 32px 52px -15px #0009;}
.floating-photo[data-slot="1"]{--x:14%;--y:19%;--r:-9deg;}
.floating-photo[data-slot="2"]{--x:46%;--y:15%;--r:5deg;}
.floating-photo[data-slot="3"]{--x:84%;--y:19%;--r:8deg;}
.floating-photo[data-slot="4"]{--x:87%;--y:76%;--r:-6deg;}
.floating-photo[data-slot="5"]{--x:59%;--y:86%;--r:6deg;}
.floating-photo[data-slot="6"]{--x:21%;--y:83%;--r:-7deg;}
.floating-photo[data-slot="7"]{--x:12%;--y:51%;--r:4deg;}
.floating-photo:hover{opacity:1;transform:translate(-50%,-55%) rotate(0deg) scale(1.035);z-index:11;}
.floating-photo:focus-visible{outline:2px solid var(--accent);outline-offset:6px;z-index:12;}
@media(max-width:700px){.faculty-moments{margin-bottom:36px;}.faculty-moments-canvas{height:440px;}.floating-photo{width:25%;}.floating-photo[data-slot="0"]{width:76%;}.floating-photo[data-slot="0"] img{max-height:280px;}.floating-photo[data-slot="1"]{--x:16%;--y:17%;}.floating-photo[data-slot="3"]{--x:83%;--y:18%;}.floating-photo[data-slot="7"]{--x:14%;--y:48%;}.floating-photo[data-slot="4"]{--x:84%;--y:78%;}.floating-photo[data-slot="6"]{--x:18%;--y:80%;}.faculty-moments-heading h2{font-size:18px;}}
@media(prefers-reduced-motion:reduce){.floating-photo,.floating-photo img{transition:none;}}
</style>
