---
// Degree-holder galleries retain the Alumni sheet row order within each degree group.
import { getCollection } from 'astro:content';
import '../../styles/people.css';
import SubLayout from '../../layouts/SubLayout.astro';
import AlumniUsMap from './AlumniUsMap.astro';
import AlumniCard from './AlumniCard.astro';
import FormerList from './FormerList.astro';
import { alumniDegreeGroup as degreeGroup, compareAlumni } from '../../lib/voices.ts';
import type { Locale } from '../../lib/locale.ts';
import { fill, t } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);

const members = await getCollection('members');
const graduates = members.filter(m=>m.data.degree?.date).sort(compareAlumni);

const degreeGroups = [
  { key: 'doctoral', label: locale === 'ko' ? '박사 졸업생' : 'Doctoral alumni' },
  { key: 'masters', label: locale === 'ko' ? '석사 졸업생' : "Master’s alumni" },
  { key: 'unclassified', label: locale === 'ko' ? '학위 구분 미기재' : 'Degree not specified' },
].map((group) => ({
  ...group,
  members: graduates.filter((member) => degreeGroup(member) === group.key),
})).filter((group) => group.members.length > 0);
// Keep only existing former members, in the requested roster order.
const rosterNames = [
  '이효택', '송한현', '홍민우', '고희주', '이강훈', '조진동', '천재희', '신재익',
  '김나리', '박인경', '이주영', '오명환', '김예진', '백승협', '민병국', '박혜성',
  '김유진', '엄희성', '김채림', '장성훈', '강효경', '신 비', '이우찬', '장이진',
  '최아진', '최병수', '유상균', '팽소원', '조현정', '최성운', '정우진', '최민서',
  '최동혁', '박규리', '권나혜', '이석호', '황준일', '정동영', '박예인',
];
const normalizeName = (name: string) => name.replace(/\s/g, '');
const formers = rosterNames.map((name) => {
  const member = members.find((m) => normalizeName(m.data.name) === normalizeName(name));
  if (!member) throw new Error(`Historical roster member not found: ${name}`);
  return member;
}).filter((member) => member.data.role === 'former');
---

<SubLayout title={s.boards.alumni} sectionKey="people" currentHref="/people/alumni/" locale={locale}>
  <AlumniUsMap slot="opening" members={members} locale={locale} />
  <section class="people-part" aria-labelledby="graduates-title">
    <h2 id="graduates-title">
      {s.people.degreeHolders} <small>{fill(s.people.count, { n: graduates.length })}</small>
    </h2>
    <nav class="alumni-degree-nav" aria-label={locale === 'ko' ? '학위별 졸업생' : 'Alumni by degree'}>
      {degreeGroups.map((group) => (
        <a href={'#alumni-' + group.key}>{group.label}<span>{group.members.length}</span></a>
      ))}
    </nav>
    {degreeGroups.map((group) => (
      <section class="alumni-degree-group" id={'alumni-' + group.key} aria-labelledby={'alumni-heading-' + group.key}>
        <h3 class="alumni-degree-heading" id={'alumni-heading-' + group.key}>
          {group.label}<small>{fill(s.people.count, { n: group.members.length })}</small>
        </h3>
        <ul class="member-list alumni-gallery alumni-gallery--graduates" data-degree={group.key}>
          {group.members.map((member) => <AlumniCard member={member} locale={locale} variant="graduate" headingLevel="h4" />)}
        </ul>
      </section>
    ))}
  </section>

  <section class="people-part" aria-labelledby="formers-title">
    <h2 id="formers-title">
      {s.people.formers} <small>{fill(s.people.count, { n: formers.length })}</small>
    </h2>
    <FormerList members={formers} locale={locale} />
  </section>
</SubLayout>
