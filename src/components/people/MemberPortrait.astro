---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  size: 'card' | 'thumbnail';
}

const { id, size } = Astro.props;
// Published portraits from the official MPBEL member directory, matched to archive member IDs.
const portraits = import.meta.glob<{ default: ImageMetadata }>('/src/assets/portraits/*.jpg', { eager: true });
const portrait = portraits[`/src/assets/portraits/${id}.jpg`]?.default;
const width = size === 'card' ? 360 : 80;
---

{portrait && (
  <Image
    src={portrait}
    alt=""
    width={width}
    height={width}
    fit="cover"
    position="attention"
    class={`member-portrait member-portrait--${size}`}
    loading="lazy"
  />
)}
