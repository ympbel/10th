---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  size: 'card' | 'thumbnail';
  fallbackName?: string;
  fit?: 'cover' | 'contain';
  natural?: boolean;
}

const { id, size, fallbackName, fit = 'cover', natural = false } = Astro.props;
// Published portraits from the official MPBEL member directory, matched to archive member IDs.
const portraits = import.meta.glob<{ default: ImageMetadata }>('/src/assets/portraits/*.jpg', { eager: true });
const portrait = portraits[`/src/assets/portraits/${id}.jpg`]?.default;
const width = natural && portrait ? (size === 'thumbnail' ? 160 : portrait.width) : size === 'card' ? 480 : 80;
const height = natural && portrait ? Math.round(width * portrait.height / portrait.width) : size === 'card' ? 600 : width;
---

{portrait && (
  <Image
    src={portrait}
    alt=""
    width={width}
    height={height}
    fit={fit}
    position="center"
    class={`member-portrait member-portrait--${size}`}
    loading="lazy"
  />
)}
{!portrait && size === 'card' && <span class="portrait-placeholder" aria-hidden="true">{fallbackName ?? 'MPBEL'}</span>}
