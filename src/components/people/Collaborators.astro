---
import collaborators from '../../data/collaborators.json';
import type { Locale } from '../../lib/locale';
const {locale}=Astro.props as {locale:Locale};
const people=[...collaborators].sort((a,b)=>a.name.localeCompare(b.name,'ko'));
---
<section class="collaborators" id="collaborators" aria-labelledby="collaborators-title">
 <header class="collaborators-heading"><div><p>COLLABORATORS</p><h2 id="collaborators-title">{locale==='ko'?<><span>함께하는</span><span>교수님들</span></>:'Collaborating professors'}</h2></div><p class="collaborators-intro">{locale==='ko'?'MPBEL과 함께 연구의 지평을 넓혀주신 교수님들을 소개합니다.':'Introducing the professors who have broadened the horizons of research with MPBEL.'}</p></header>
 <ul class="collaborators-grid">{people.map(person=><li><a href={person.source} target="_blank" rel="noopener noreferrer"><div class="collaborator-identity"><h3>{locale==='ko'?person.name:person.name_en}</h3>{locale==='ko'&&person.name!==person.name_en&&<p class="collaborator-english">{person.name_en}</p>}</div><img class="collaborator-photo" src={import.meta.env.BASE_URL.replace(/\/?$/, '/')+person.photo} alt="" width="80" height="100" loading="lazy" decoding="async" /><p class="collaborator-affiliation">{locale==='ko'?person.affiliation:person.affiliation_en}</p></a></li>)}</ul>
</section>
<style>
.collaborators{display:grid;grid-template-columns:230px minmax(0,1fr);gap:56px;padding:64px 0 24px;margin-top:40px;border-top:1px solid var(--rule);scroll-margin-top:32px;}
.collaborators-heading{align-self:start;position:sticky;top:40px;}
.collaborators-heading>div>p{font-size:11px;font-weight:600;letter-spacing:.18em;color:var(--accent);margin:0 0 16px;}
.collaborators-heading h2{font-size:40px;line-height:1.3;font-weight:500;letter-spacing:-.045em;color:var(--text-primary);margin:0;}
.collaborators-heading h2 span{display:block;}
.collaborators-heading h2 span:first-child{font-size:28px;font-weight:400;color:var(--text-secondary);margin-bottom:5px;}
.collaborators-intro{max-width:220px;margin:24px 0 0;font-size:14px;line-height:1.9;word-break:keep-all;color:var(--text-secondary);}
.collaborators-grid{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:0;margin:0;}
.collaborators-grid li{min-width:0;}
.collaborators-grid a{height:100%;min-height:180px;box-sizing:border-box;display:grid;grid-template-columns:minmax(0,1fr) 80px;grid-template-rows:1fr auto;gap:16px 12px;padding:20px;border:1px solid var(--rule);border-radius:8px;text-decoration:none;color:var(--text-primary);background:color-mix(in srgb,var(--text-primary) 2%,transparent);transition:background .2s,border-color .2s,transform .2s;}
.collaborators-grid h3{display:flex;align-items:start;justify-content:space-between;gap:8px;font-size:20px;line-height:1.4;font-weight:500;margin:0;letter-spacing:-.025em;word-break:keep-all;overflow-wrap:anywhere;}
.collaborator-arrow{font-size:16px;color:var(--text-secondary);opacity:.45;transition:color .2s,opacity .2s;}
.collaborator-english{font-size:12px;color:var(--text-secondary);margin:4px 0 0;line-height:1.5;}
.collaborator-identity{min-width:0;}
.collaborator-photo{width:80px;height:100px;object-fit:cover;object-position:center 20%;border-radius:4px;background:#fff;}
.collaborator-affiliation{grid-column:1/-1;font-size:13px;line-height:1.6;color:var(--text-secondary);margin:0;padding-top:0;word-break:keep-all;}
.collaborators-grid a:hover{background:color-mix(in srgb,var(--accent) 7%,transparent);border-color:color-mix(in srgb,var(--accent) 50%,var(--rule));transform:translateY(-3px);}
.collaborators-grid a:hover .collaborator-arrow{color:var(--accent);opacity:1;}
.collaborators-grid a:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}
@media(max-width:1100px){.collaborators{grid-template-columns:190px minmax(0,1fr);gap:32px;}.collaborators-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:700px){.collaborators{grid-template-columns:1fr;gap:28px;padding-top:36px;}.collaborators-heading{position:static;}.collaborators-heading h2{font-size:34px;}.collaborators-heading h2 span:first-child{font-size:24px;}.collaborators-intro{max-width:320px;margin-top:18px;}.collaborators-grid{gap:10px;}.collaborators-grid a{padding:14px;min-height:180px;grid-template-columns:minmax(0,1fr) 60px;gap:14px 8px;}.collaborator-photo{width:60px;height:78px;}.collaborators-grid h3{font-size:18px;}.collaborator-english{overflow-wrap:anywhere;}}
@media(prefers-reduced-motion:reduce){.collaborators-grid a{transition:none;}.collaborators-grid a:hover{transform:none;}}
</style>
