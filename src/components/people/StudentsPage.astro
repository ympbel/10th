---
// The students board (학생 현황) in one language: the faculty block (professors in `order`, the advisor linking to the
// main site), then one card per current student, earliest join first, with their record counts.
import { getCollection } from 'astro:content';
import '../../styles/people.css';
import SubLayout from '../../layouts/SubLayout.astro';
import ProfessorRow from './ProfessorRow.astro';
import MemberCard from './MemberCard.astro';
import { sortMembersByJoined } from '../../lib/content.ts';
import { itemsOf } from '../../lib/people.ts';
import { isLabEra } from '../../lib/years.ts';
import type { Locale } from '../../lib/locale.ts';
import { fill, t } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);

const [members, papers, presentations, awards] = await Promise.all([
  getCollection('members'),
  getCollection('papers'),
  getCollection('presentations'),
  getCollection('awards'),
]);

const professors = members
  .filter((m) => m.data.role === 'professor')
  .sort((a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER));
const students = sortMembersByJoined(
  members.filter((m) => m.data.role === 'student'),
  'asc',
);

// Papers count from 2016 on, like the home figures.
const records = { papers: papers.filter((p) => isLabEra(p.data.year)), presentations, awards };
const countsOf = (id: string) => {
  const items = itemsOf(id, records);
  return { papers: items.papers.length, presentations: items.presentations.length, awards: items.awards.length };
};
---

<SubLayout title={s.boards.students} sectionKey="people" currentHref="/people/students/" locale={locale}>
  <section class="people-part professors" aria-labelledby="faculty-title">
    <h2 id="faculty-title">
      {s.people.faculty} <small>{fill(s.people.count, { n: professors.length })}</small>
    </h2>
    <ul class="prof-list">
      {professors.map((m) => <ProfessorRow member={m.data} locale={locale} />)}
    </ul>
  </section>

  <section class="people-part" aria-labelledby="students-title">
    <h2 id="students-title">
      {s.people.students} <small>{fill(s.people.count, { n: students.length })}</small>
    </h2>
    <ul class="member-list">
      {students.map((m) => <MemberCard member={m} counts={countsOf(m.id)} locale={locale} />)}
    </ul>
  </section>
</SubLayout>
