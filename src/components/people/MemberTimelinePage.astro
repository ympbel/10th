---
import SubLayout from '../../layouts/SubLayout.astro';
import MemberTimeline from './MemberTimeline.astro';
import type { Locale } from '../../lib/locale.ts';
interface Props {locale:Locale}
const {locale}=Astro.props;
---
<SubLayout title={locale==='ko'?'멤버 타임라인':'Member timeline'} sectionKey="people" currentHref="/people/timeline/" locale={locale}>
 <MemberTimeline locale={locale} />
</SubLayout>
