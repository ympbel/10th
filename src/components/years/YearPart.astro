---
// One part of a year page (also of a person page): a section with its heading, then its content, or the "no records"
// line when there is nothing for it. The section stays either way, so every page has the same parts in the same
// order. The id is the target of the year summary line's link to the part. A person page adds the count beside the
// heading and may put a note under it (the `note` slot), which shows even when the part is empty.
import type { Locale } from '../../lib/locale.ts';
import { t, type Strings } from '../../i18n/index.ts';

interface Props {
  /** `joined`, `degrees`, `papers`, … : the section's `data-part` and the key of its heading in src/i18n. */
  part: keyof Strings['yearPage']['parts'];
  empty: boolean;
  locale: Locale;
  /** A count shown small beside the heading (`5편`). */
  count?: string;
}

const { part, empty, locale, count } = Astro.props;
const s = t(locale);
---

<section class="yr-part" data-part={part} id={`part-${part}`} aria-labelledby={`part-${part}-title`}>
  <h2 id={`part-${part}-title`}>
    {s.yearPage.parts[part]}{count && ' '}{count && <small>{count}</small>}
  </h2>
  <slot name="note" />
  {empty ? <p class="empty">{s.noRecords}</p> : <slot />}
</section>
