---
// One paper in a list (year pages, person pages): the bold title (a link when the paper has one), the author line
// (first author in bold, co-first authors in parentheses, then the corresponding authors), and the journal with the
// impact factor at the right end. Styles are in styles/years.css (.yr-item, .yr-title, .yr-sub, .yr-meta).
import type { CollectionEntry } from 'astro:content';
import { langOf, type Locale } from '../lib/locale.ts';
import { fill, t } from '../i18n/index.ts';

interface Props {
  paper: CollectionEntry<'papers'>['data'];
  locale: Locale;
}

const { paper, locale } = Astro.props;
const yp = t(locale).yearPage;

const first = paper.first_author;
/** Co-first and corresponding authors after the bold first author. */
const rest = [
  paper.co_first.length > 0 ? `(${paper.co_first.join(', ')})` : '',
  paper.corresponding.length > 0 ? `${yp.corresponding}: ${paper.corresponding.join(', ')}` : '',
]
  .filter(Boolean)
  .join(', ');
const authorsLang = langOf([first, ...paper.co_first, ...paper.corresponding].join(' '), locale);
---

<li class="yr-item">
  <p class="yr-title" lang={langOf(paper.title, locale)}>
    {
      paper.link ? (
        <a href={paper.link} target="_blank" rel="noopener">
          {paper.title}
        </a>
      ) : (
        paper.title
      )
    }
  </p>
  {
    (first || rest) && (
      <p class="yr-sub" lang={authorsLang}>
        {first && <b>{first}</b>}
        {first && rest && ', '}
        {rest}
      </p>
    )
  }
  <p class="yr-meta">
    <span>{paper.journal}</span>
    {paper.impact_factor !== undefined && <span class="yr-if">{fill(yp.impactFactor, { n: paper.impact_factor })}</span>}
  </p>
</li>
