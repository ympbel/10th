---
// Top bar: logo and archive label (home link), the six menu sections with their dropdowns, the KR/EN toggle. Below
// 1200px the menu becomes a drawer opened by the toggle button and closed by it or by Escape (responsive.css,
// script below).
import { chapters } from '../lib/chapters.ts';
import { MENU } from '../lib/menu.ts';
import { localePath, otherLocaleHref, type Locale } from '../lib/locale.ts';
import { url } from '../lib/url.ts';
import { t } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  edition?: boolean;
  /** The KR/EN hrefs, for a page that has no address of its own (404). Without it, the toggle links this page's
   * address in each language. */
  languageHrefs?: Record<Locale, string>;
}

const { locale, languageHrefs, edition = false } = Astro.props;
const s = t(locale);
// The toggle links to the same page in each language: this page for the current one, its counterpart for the other.
const here = Astro.url.pathname;
const languages: Array<{ locale: Locale; label: string; href: string }> = [
  { locale: 'ko', label: 'KR', href: languageHrefs?.ko ?? (locale === 'ko' ? here : otherLocaleHref(here)) },
  { locale: 'en', label: 'EN', href: languageHrefs?.en ?? (locale === 'en' ? here : otherLocaleHref(here)) },
];
---

<header class:list={['topmenu', { 'magazine-header': edition }]}>
  <div class="topmenu-inner">
    <a class="logo" aria-label={s.logoAlt} href={url(localePath('/', locale))}>
      <img class="logo-light" src={url('/images/site/logo.png')} alt={s.logoAlt} width="142" height="50" />
      <img class="logo-dark" src={url('/images/site/logo-dark.svg')} alt="" aria-hidden="true" width="142" height="43" />
      <span class="logo-label">{s.archiveLabel}</span>
    </a>
    {edition && <a class="header-contents" href={url(localePath('/', locale)) + '#edition-contents'}>{locale === 'ko' ? '목차' : 'Contents'}</a>}
    {/* The toggle comes before the drawer it opens so Tab goes from it into the menu; below 1200px flex `order` puts
        KR/EN before it on screen (responsive.css). It is hidden on desktop. */}
    <button type="button" class="nav-toggle" aria-label={s.menuToggle} aria-expanded="false" aria-controls="navi">
      <svg width="20" height="13" viewBox="0 0 20 13" aria-hidden="true">
        <path d="M0 .5h20M0 6.5h20M0 12.5h20" fill="none" stroke="currentColor" stroke-width="1"></path>
      </svg>
    </button>
    <nav id="navi" class="nav" aria-label={s.mainNav}>
      <div class="drawer-edition">
        <a class="drawer-cover" href={url(localePath('/archive/photos/', locale))}>
          <img src={url('/images/photos/2026/20260515-0c4b491257-thumb.jpg')} alt={locale === 'ko' ? '2026년 스승의 날 MPBEL 단체 사진' : 'MPBEL together on Teachers’ Day 2026'} loading="lazy" />
          <span>MPBEL / 10 YEARS TOGETHER</span>
        </a>
        <div class="drawer-index"><p>{locale === 'ko' ? '10주년 기념 책자' : 'The anniversary edition'}</p><ol>
          {chapters.map((chapter,index) => <li><a href={chapter.path === '/years/' ? url(localePath('/',locale))+'#history' : url(localePath(chapter.path,locale))}><small>{String(index+1).padStart(2,'0')}</small><span>{locale === 'ko' ? chapter.ko : chapter.title}</span><span aria-hidden="true">↗</span></a></li>)}
        </ol><div class="drawer-more">{MENU.flatMap(section => section.items).filter(item => ['/projects/','/activity/seminars/','/activity/workshops/'].includes(item.href)).map(item => <a href={url(localePath(item.href,locale))}>{item.label[locale]}</a>)}</div></div>
      </div>
      <ul id="nav">
        {
          MENU.map((section) => (
            <li>
              <a href={url(localePath(section.items[0].href, locale))}>{section.label}</a>
              <ul class="sub">
                {section.items.map((item) => (
                  <li>
                    <a href={url(localePath(item.href, locale))}>{item.label[locale]}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label={locale === 'ko' ? '다크 모드' : 'Dark mode'} aria-pressed="false"><span class="theme-icon" aria-hidden="true">◐</span><span class="theme-toggle-label">{locale === 'ko' ? '다크' : 'Dark'}</span></button>
    <div class="langbut" role="group" aria-label={s.language}>
      <ul>
        {
          languages.map((l) => (
            <li class={l.locale === locale ? 'active' : undefined}>
              <a href={l.href} hreflang={l.locale} aria-current={l.locale === locale ? 'true' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>
<script is:inline>
  (function () {
    var toggle = document.querySelector('.nav-toggle');
    var navi = document.getElementById('navi');
    if (!toggle || !navi) return;
    function setOpen(open) {
      navi.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    toggle.addEventListener('click', function () {
      setOpen(!navi.classList.contains('open'));
    });
    // Escape closes the open drawer and returns focus to the toggle.
    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape' || !navi.classList.contains('open')) return;
      setOpen(false);
      toggle.focus();
    });
  })();
</script>

<script>
 const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
 const ko = document.documentElement.lang === 'ko';
 const update = () => { const dark = document.documentElement.dataset.theme === 'dark'; if (!button) return; button.setAttribute('aria-pressed',String(dark)); button.setAttribute('aria-label',ko ? (dark?'라이트 모드':'다크 모드') : (dark?'Light mode':'Dark mode')); const label=button.querySelector('.theme-toggle-label'); if(label) label.textContent=ko?(dark?'라이트':'다크'):(dark?'Light':'Dark'); };
 update();
 button?.addEventListener('click',()=>{const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=theme;try{localStorage.setItem('mpbel-theme',theme);}catch(e){}update();});
 matchMedia('(prefers-color-scheme: dark)').addEventListener('change',(e)=>{try{if(!localStorage.getItem('mpbel-theme')){document.documentElement.dataset.theme=e.matches?'dark':'light';update();}}catch(err){}});
</script>
