---
// A year page in one language: the sub page frame with the year tab rail in the side area, the summary line, then
// one part each for who joined, who took a degree, papers, presentations (one heading per conference), awards,
// projects running that year, the year's seminars, and photos when there are any. This component loads the
// collections once and turns them into the plain values the markup shows.
import { getCollection } from 'astro:content';
import '../styles/years.css';
import SubLayout from '../layouts/SubLayout.astro';
import YearTabs from './YearTabs.astro';
import YearPart from './years/YearPart.astro';
import PaperItem from './PaperItem.astro';
import MemberLink from './people/MemberLink.astro';
import PhotoGrid from './PhotoGrid.astro';
import { yearStats } from '../lib/years.ts';
import { groupBy, sortByYearDesc, sortMembersByJoined, yearMonth } from '../lib/content.ts';
import { awardRecipient, displayName, field } from '../lib/people.ts';
import { langOf, localePath, type Locale } from '../lib/locale.ts';
import { url } from '../lib/url.ts';
import { fill, t } from '../i18n/index.ts';

interface Props {
  year: number;
  locale: Locale;
}

const { year, locale } = Astro.props;
const s = t(locale);
const yp = s.yearPage;

const [members, papers, presentations, awards, projects, seminars, photos] = await Promise.all([
  getCollection('members'),
  getCollection('papers'),
  getCollection('presentations'),
  getCollection('awards'),
  getCollection('projects'),
  getCollection('seminars'),
  getCollection('photos'),
]);
const stats = yearStats(year, { members, papers, presentations, awards, projects });
const memberBySlug = new Map(members.map((m) => [m.id, m]));

/** This year's records in sheet order. */
const ofYear = <T extends { id: string; data: { year: number; order?: number } }>(items: T[]) =>
  sortByYearDesc(items.filter((item) => item.data.year === year));

/** `ko` for Korean text on this page when it is English, so screen readers read it in Korean. */
const lang = (text: string | undefined) => langOf(text, locale);

type Member = (typeof members)[number];
/** A member's name in this language, with the slug of their person page. */
const person = (m: Member) => ({ slug: m.id, name: displayName(m.data, locale) });

const joined = sortMembersByJoined(stats.joined, 'asc').map(person);

const byDegreeDate = (a: Member, b: Member) =>
  (a.data.degree?.date ?? '').localeCompare(b.data.degree?.date ?? '') || a.id.localeCompare(b.id);
const degrees = [...stats.degrees].sort(byDegreeDate).map((m) => {
  const degree = m.data.degree;
  const type = degree?.type ? field(degree, 'type', locale) : undefined;
  const affiliation = [
    m.data.affiliation && field(m.data, 'affiliation', locale),
    m.data.position && field(m.data, 'position', locale),
  ]
    .filter(Boolean)
    .join(', ');
  return {
    ...person(m),
    detail: [type, degree?.date && yearMonth(degree.date)].filter(Boolean).join(' · '),
    detailLang: lang(type),
    affiliation,
    affiliationLang: lang(affiliation),
  };
});

const yearPapers = ofYear(papers);

const conferences = [...groupBy(ofYear(presentations), 'conference')].map(([conference, items]) => ({
  conference,
  items: items.map((p) => ({ title: p.data.title, firstAuthor: p.data.first_author, type: p.data.type })),
}));
const presentationCount = conferences.reduce((n, c) => n + c.items.length, 0);

const yearAwards = ofYear(awards).map((a) => {
  const category = field(a.data, 'category', locale);
  const where = `${a.data.conference} · ${category}`;
  return {
    // A member recipient by name in this language, linked unless a professor; anyone else as the sheet wrote it.
    ...awardRecipient(a.data, memberBySlug, locale),
    where,
    whereLang: lang(where),
    title: a.data.title,
  };
});

const running = [...stats.projectsRunning]
  .sort((a, b) => b.data.start.localeCompare(a.data.start) || a.id.localeCompare(b.id))
  .map((p) => {
    const title = field(p.data, 'title', locale);
    return {
      title,
      titleLang: lang(title),
      agency: p.data.agency,
      agencyLang: lang(p.data.agency),
      period: `${yearMonth(p.data.start)} – ${yearMonth(p.data.end)}`,
    };
  });

const seminarCount = seminars.filter((sem) => sem.data.date.startsWith(`${year}-`)).length;
const yearPhotos = ofYear(photos);

/** The summary line: one count per part, each linking to its part below. */
const summary = (['joined', 'degrees', 'papers', 'presentations', 'awards', 'projects'] as const).map((part) => {
  const n = {
    joined: joined.length,
    degrees: degrees.length,
    papers: yearPapers.length,
    presentations: presentationCount,
    awards: yearAwards.length,
    projects: running.length,
  }[part];
  const [before, after] = yp.summary[part].split('{n}');
  return { part, n, before, after };
});
---

<SubLayout title={String(year)} currentHref={`/years/${year}/`} locale={locale} side="years">
  <YearTabs slot="side" current={year} locale={locale} />

  <p class="year-summary">
    {
      summary.map((item, i) => (
        <>
          {i > 0 && <span class="sep"> · </span>}
          <a href={`#part-${item.part}`}>{item.before}<b>{item.n}</b>{item.after}</a>
        </>
      ))
    }
  </p>

  <YearPart part="joined" empty={joined.length === 0} locale={locale}>
    <ul class="yr-names">
      {
        joined.map((m) => (
          <li>
            <MemberLink class="name" id={m.slug} name={m.name} locale={locale} />
          </li>
        ))
      }
    </ul>
  </YearPart>

  <YearPart part="degrees" empty={degrees.length === 0} locale={locale}>
    <ul class="yr-list">
      {
        degrees.map((m) => (
          <li class="yr-row yr-item">
            <MemberLink class="name" id={m.slug} name={m.name} locale={locale} />
            <div>
              <p lang={m.detailLang}>{m.detail}</p>
              {m.affiliation && (
                <p class="yr-sub" lang={m.affiliationLang}>
                  {m.affiliation}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </YearPart>

  <YearPart part="papers" empty={yearPapers.length === 0} locale={locale}>
    <ol class="yr-list yr-papers">
      {
        yearPapers.map((p) => <PaperItem paper={p.data} people={memberBySlug} locale={locale} />)
      }
    </ol>
  </YearPart>

  <YearPart part="presentations" empty={presentationCount === 0} locale={locale}>
    {
      conferences.map((c) => (
        <div class="yr-conf">
          <h3>
            {c.conference} <small>{fill(yp.conferenceCount, { n: c.items.length })}</small>
          </h3>
          <ul class="yr-list">
            {c.items.map((p) => (
              <li class="yr-item">
                <p lang={lang(p.title)}>{p.title}</p>
                <p class="yr-sub">
                  {p.firstAuthor && <span lang={lang(p.firstAuthor)}>{p.firstAuthor}</span>}
                  <span class="yr-type">{p.type}</span>
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </YearPart>

  <YearPart part="awards" empty={yearAwards.length === 0} locale={locale}>
    <ul class="yr-list">
      {
        yearAwards.map((a) => (
          <li class="yr-row yr-item">
            {a.slug ? (
              <MemberLink class="name" id={a.slug} name={a.name} locale={locale} />
            ) : (
              <span class="name" lang={lang(a.name)}>
                {a.name}
              </span>
            )}
            <div>
              <p lang={a.whereLang}>{a.where}</p>
              {a.title && (
                <p class="yr-sub" lang={lang(a.title)}>
                  {a.title}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </YearPart>

  <YearPart part="projects" empty={running.length === 0} locale={locale}>
    <ul class="yr-list">
      {
        running.map((p) => (
          <li class="yr-row yr-item">
            <span class="yr-period">{p.period}</span>
            <div>
              <p class="yr-title" lang={p.titleLang}>
                {p.title}
              </p>
              <p class="yr-sub" lang={p.agencyLang}>
                {p.agency}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </YearPart>

  <YearPart part="seminars" empty={seminarCount === 0} locale={locale}>
    <p class="yr-seminars">
      {fill(yp.seminarsCount, { n: seminarCount })}
      <a class="more" href={url(localePath('/activity/seminars/', locale))}>
        {yp.seminarsLink} <span aria-hidden="true">→</span>
      </a>
    </p>
  </YearPart>

  {
    yearPhotos.length > 0 && (
      <YearPart part="photos" empty={false} locale={locale}>
        <PhotoGrid photos={yearPhotos} members={memberBySlug} locale={locale} />
      </YearPart>
    )
  }
</SubLayout>
