---
import archive from '../../data/archive-analytics.json';
import type { Locale } from '../../lib/locale.ts';
import '../../styles/analytics.css';
import '../../styles/funding.css';
interface Props { locale: Locale }
const {locale}=Astro.props;const ko=locale==='ko';const d=archive.funding;const k=d.k;
const money=(n:number)=>(n/1e8).toLocaleString(ko?'ko-KR':'en-US',{maximumFractionDigits:1});
const num=(n:number)=>n.toLocaleString(ko?'ko-KR':'en-US');
const cats=[{key:'정부',en:'Government',color:'var(--analytics-blue)'},{key:'민간',en:'Industry',color:'var(--analytics-teal)'},{key:'교내',en:'University',color:'var(--analytics-gold)'}] as const;
const colorOf=(cat:string)=>cats.find(c=>c.key===cat)?.color ?? 'var(--accent)';
const cap=Math.ceil(Math.max(...d.byYear.map(r=>r.tot))/5e8)*5e8;
const maxNew=Math.max(...d.byYear.map(r=>r.new));
let cumulative=0;const annual=d.byYear.map(r=>({...r,cumulative:cumulative+=r.tot}));
const linePoints=annual.map((r,i)=>`${105+i*90},${270-r.cumulative/d.tot.a*225}`).join(' ');
const principalTotal=k.projects.reduce((sum,p)=>sum+p.a,0);
let principalCum=0;const principalYears=k.byYear.map(r=>({...r,cumulative:principalCum+=r.a}));
const maxPrincipal=Math.max(...k.byYear.map(r=>r.a));
const fieldColors=['var(--analytics-blue)','var(--analytics-teal)','var(--analytics-gold)','#708bc0','#8f84bb','#bd826c','#6f9d86','#87959f'];
const groups=[{id:'funding-field',title:ko?'연구분야별':'Research fields',rows:k.field},{id:'funding-source',title:ko?'부처 / 재원별':'Ministries / funding sources',rows:k.min}];
const yearStart=2016,yearEnd=2027.4;
const monthValue=(s:string,end=false)=>{const [year,month]=s.split('.').map(Number);return year+(month-1+(end?1:0))/12;};
const position=(n:number)=>(n-yearStart)/(yearEnd-yearStart)*100;
const links=[['funding-year-trend',ko?'연도별 수주':'Annual funding'],['principal-year',ko?'연도별 정리':'Annual breakdown'],['funding-mix',ko?'분야·재원':'Fields & sources'],['project-timeline',ko?'과제 타임라인':'Project timeline'],['unique-projects',ko?'고유 과제 목록':'Unique projects']];
---
<div class="funding-edition" id="funding">
 <nav class="analytics-jumps" aria-label={ko?'연구비 페이지 항목':'Funding sections'}>{links.map(([id,label])=><a href={'#'+id}>{label}</a>)}</nav>
 <section class="analytics funding-dashboard" id="funding-year-trend" aria-labelledby="funding-title">
  <header class="analytics-head"><div><p class="analytics-kicker">RESEARCH / FUNDING</p><h2 id="funding-title">{ko?'연도별 수주 추이':'Annual funding'}</h2></div><span>{archive.funding_period} · {ko?'연구실 전체':'Laboratory total'}</span></header>
  <dl class="analytics-stats"><div><dt>{ko?'누적 연구비 (억원)':'Funding (KRW 100M)'}</dt><dd>{money(d.tot.a)}</dd></div><div><dt>{ko?'고유 과제':'Unique projects'}</dt><dd>{d.tot.u}</dd></div><div><dt>{ko?'연차 협약':'Annual agreements'}</dt><dd>{d.tot.r}</dd></div><div><dt>{ko?'연구책임자':'Principal investigators'}</dt><dd>{d.tot.pi}</dd></div></dl>
  <div class="analytics-chart-head"><h3>{ko?'연간 수주와 누적 성장':'Annual awards and cumulative growth'}</h3><div class="analytics-switch" aria-label={ko?'연구비 그래프 항목':'Funding chart metric'}><button type="button" data-funding-view="amount" aria-pressed="true">{ko?'연구비':'Funding'}</button><button type="button" data-funding-view="projects" aria-pressed="false">{ko?'신규 과제수':'New projects'}</button></div></div>
  <div class="analytics-legend" data-funding-legend>{cats.map(c=><span><i style={'background:'+c.color}/>{ko?c.key:c.en}</span>)}<span class="funding-line-key">{ko?'누적 연구비 · 오른쪽 축':'Cumulative funding · right axis'}</span></div>
  <div class="analytics-scroll" data-funding-panel="amount"><svg class="analytics-chart" viewBox="0 0 1170 350" role="img" aria-labelledby="funding-chart-title"><title id="funding-chart-title">{ko?'정부·민간·교내 연구비와 누적 연구비, 단위 억원':'Annual funding by source and cumulative funding, KRW 100M'}</title>
   {Array.from({length:6},(_,i)=>{const y=270-i*45;return <g><path d={`M60 ${y}H1080`} class="analytics-grid"/><text x="44" y={y+4} text-anchor="end" class="analytics-axis">{money(cap*i/5)}</text><text x="1100" y={y+4} class="analytics-axis">{money(d.tot.a*i/5)}</text></g>;})}
   {annual.map((r,i)=>{const x=85+i*90;let accumulated=0;return <g data-funding-year={r.y} data-total={r.tot}><title>{r.y}: {num(r.tot)} KRW</title>{[...cats].reverse().map(c=>{const height=r[c.key]/cap*225;const y=270-accumulated-height;accumulated+=height;return <rect x={x} y={y} width="40" height={height} fill={c.color}><title>{ko?c.key:c.en}: {money(r[c.key])}</title></rect>;})}<text x={x+20} y={260-r.tot/cap*225} text-anchor="middle" class="analytics-value">{money(r.tot)}</text><text x={x+20} y="303" text-anchor="middle" class="analytics-axis">{r.y}</text><text x={x+20} y="325" text-anchor="middle" class="analytics-axis funding-chart-meta">{r.rows} {ko?'연차':'agreements'}</text></g>;})}
   <polyline points={linePoints} class="funding-cumulative"/>{annual.map((r,i)=><circle cx={105+i*90} cy={270-r.cumulative/d.tot.a*225} r="3" class="funding-cumulative-dot"><title>{r.y}: {money(r.cumulative)} {ko?'억원 누적':'× KRW 100M cumulative'}</title></circle>)}
  </svg></div>
  <div class="analytics-scroll" data-funding-panel="projects" hidden><svg class="analytics-chart" viewBox="0 0 1100 350" role="img" aria-label={ko?'연도별 신규 고유 과제 수':'New unique projects by year'}>{[0,3,6,9,12].map(n=><g><path d={`M60 ${270-n/maxNew*215}H1080`} class="analytics-grid"/><text x="44" y={274-n/maxNew*215} text-anchor="end" class="analytics-axis">{n}</text></g>)}{annual.map((r,i)=><g><rect x={85+i*90} y={270-r.new/maxNew*215} width="40" height={r.new/maxNew*215} fill="var(--analytics-blue)"/><text x={105+i*90} y={258-r.new/maxNew*215} text-anchor="middle" class="analytics-value">{r.new}</text><text x={105+i*90} y="303" text-anchor="middle" class="analytics-axis">{r.y}</text><text x={105+i*90} y="325" text-anchor="middle" class="analytics-axis funding-chart-meta">{r.rows} {ko?'연차':'agreements'}</text></g>)}</svg></div>
 </section>
 <div class="funding-focus">
  <header class="funding-focus-heading"><p class="analytics-kicker">PRINCIPAL INVESTIGATOR / JIN SUNG KIM</p><h2>{ko?'김진성 교수 연구과제':'Research led by Jin Sung Kim'}</h2><div><strong>{money(principalTotal)}<small>{ko?'억원':'× KRW 100M'}</small></strong></div></header>
  <section class="analytics" id="principal-year" aria-labelledby="principal-year-title">
   <header class="analytics-head"><h2 id="principal-year-title">{ko?'연도별 정리':'Annual breakdown'}</h2><span>{ko?'단위: 억원':'Unit: KRW 100M'}</span></header>
   <div class="analytics-scroll"><table class="analytics-table funding-year-table"><thead><tr><th>{ko?'연도':'Year'}</th><th>{ko?'신규 과제':'New'}</th><th>{ko?'진행 연차':'Agreements'}</th>{cats.map(c=><th>{ko?c.key:c.en}</th>)}<th>{ko?'연간 합계':'Annual total'}</th><th>{ko?'구성·규모':'Mix & scale'}</th><th>{ko?'누적':'Cumulative'}</th></tr></thead><tbody>{principalYears.map(r=><tr data-principal-year={r.y}><th scope="row">{r.y}</th><td>{r.new || '—'}</td><td>{r.rows}</td>{cats.map(c=><td>{r[c.key]?money(r[c.key]):'—'}</td>)}<td class="funding-emphasis">{money(r.a)}</td><td><div class="funding-mix-bar" style={`width:${r.a/maxPrincipal*150}px`}>{cats.map(c=><i style={`width:${r[c.key]/r.a*100}%;background:${c.color}`}/>)}</div></td><td>{money(r.cumulative)}</td></tr>)}</tbody><tfoot><tr><th>{ko?'합계':'Total'}</th><td>{k.projects.length}</td><td>{k.projects.reduce((s,p)=>s+p.n,0)}</td>{cats.map(c=><td>{money(k.byYear.reduce((s,r)=>s+r[c.key],0))}</td>)}<td>{money(principalTotal)}</td><td></td><td>{money(principalTotal)}</td></tr></tfoot></table></div>
  </section>
  <section class="analytics" id="funding-mix" aria-labelledby="funding-mix-title">
   <header class="analytics-head"><h2 id="funding-mix-title">{ko?'분야 · 재원 구성':'Fields & funding sources'}</h2><span>{k.projects.length} {ko?'고유 과제':'unique projects'}</span></header>
   <div class="funding-distributions">{groups.map((group,gi)=>{const max=Math.max(...group.rows.map(r=>r.a));return <section id={group.id}><h3>{group.title}</h3><div class="funding-horizontal-bars">{group.rows.map((r,i)=><div><header><span>{r.n}</span><strong>{money(r.a)}<small>{ko?'억':'× KRW 100M'} · {r.u}{ko?'건':' projects'}</small></strong></header><div class="funding-bar-line"><div class="analytics-track"><i style={`width:${r.a/max*100}%;background:${gi===0?fieldColors[i%fieldColors.length]:'var(--accent)'}`}/></div><span>{(r.a/principalTotal*100).toFixed(0)}%</span></div></div>)}</div></section>;})}</div>
  </section>
  <section class="analytics" id="project-timeline" aria-labelledby="project-timeline-title">
   <header class="analytics-head"><h2 id="project-timeline-title">{ko?'과제 타임라인':'Project timeline'}</h2><span>2016–2027 · {ko?'총 수행기간':'Full project periods'}</span></header>
   <div class="analytics-legend">{cats.map(c=><span><i style={'background:'+c.color}/>{ko?c.key:c.en}</span>)}</div>
   <div class="analytics-scroll"><div class="funding-gantt"><div class="funding-gantt-head"><span>{ko?'연구과제':'Research project'}</span><div>{Array.from({length:12},(_,i)=><span style={`left:${position(2016+i)}%`}>{2016+i}</span>)}</div></div>{k.projects.map((p,i)=><div class="funding-gantt-row" data-project-index={i}><a href={'#funding-project-'+i} title={p.nm}><strong>{p.nm}</strong><small>{p.mi.replace('의과대학-','')} · {money(p.a)}{ko?'억원':' × KRW 100M'}</small></a><div class="funding-gantt-track" aria-label={`${p.ps}–${p.pe}`}><span class="funding-gantt-bar" style={`left:${position(monthValue(p.ps))}%;width:${position(monthValue(p.pe,true))-position(monthValue(p.ps))}%;background:${colorOf(p.cat)}`}><span class="funding-term" style={`color:${colorOf(p.cat)}`}>{p.n}{ko?'차':' terms'}</span></span></div></div>)}</div></div>
  </section>
  <section class="analytics" id="unique-projects" aria-labelledby="unique-projects-title">
   <header class="analytics-head"><h2 id="unique-projects-title">{ko?'고유 과제 목록':'Unique project register'}</h2><span>{ko?'연차 통합 16건 · 착수 순':'16 projects · ordered by start'}</span></header>
   <div class="analytics-scroll"><table class="analytics-table funding-project-register"><thead><tr><th>{ko?'과제명':'Project'}</th><th>{ko?'분류':'Type'}</th><th>{ko?'부처 / 재원':'Ministry / source'}</th><th>{ko?'연구분야':'Field'}</th><th>{ko?'연차':'Terms'}</th><th>{ko?'수행기간':'Period'}</th><th>{ko?'총 협약액 (원)':'Contracted funding (KRW)'}</th></tr></thead><tbody>{k.projects.map((p,i)=><tr id={'funding-project-'+i}><th scope="row"><strong>{p.nm}</strong><small>{[p.ag,p.pg].filter(Boolean).join(' · ')}</small></th><td><span class="funding-type-tag" style={`--type-color:${colorOf(p.cat)}`}>{ko?p.cat:cats.find(c=>c.key===p.cat)?.en}</span></td><td>{p.mi}</td><td>{p.fd}</td><td>{p.n}</td><td>{p.ps}–{p.pe}</td><td>{num(p.a)}</td></tr>)}</tbody><tfoot><tr><th>{k.projects.length} {ko?'고유 과제':'unique projects'}</th><td colspan="3"></td><td>{k.projects.reduce((s,p)=>s+p.n,0)}</td><td></td><td>{num(principalTotal)}</td></tr></tfoot></table></div>
  </section>
 </div>
</div>
<script>
 const root=document.querySelector('.funding-dashboard');
 root?.querySelectorAll<HTMLButtonElement>('[data-funding-view]').forEach(button=>button.addEventListener('click',()=>{root.querySelectorAll<HTMLElement>('[data-funding-panel]').forEach(panel=>panel.hidden=panel.dataset.fundingPanel!==button.dataset.fundingView);const legend=root.querySelector<HTMLElement>('[data-funding-legend]');if(legend)legend.hidden=button.dataset.fundingView!=='amount';root.querySelectorAll('[data-funding-view]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
</script>
