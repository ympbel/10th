---
// Temporary year pages so the home timeline links resolve; plan Task 9 replaces them with the year pages.
import '../../styles/global.css';
import SubLayout from '../../layouts/SubLayout.astro';
import { YEARS } from '../../lib/years.ts';
import { t } from '../../i18n/index.ts';

export function getStaticPaths() {
  return YEARS.map((year) => ({ params: { year: String(year) } }));
}

const { year } = Astro.params;
const s = t('ko');
---

<SubLayout title={year} currentHref={`/years/${year}/`} locale="ko" side="years">
  <p>{s.preparing}</p>
</SubLayout>
