---
// Temporary home until the home page is built (plan Task 8): the shared frame with the site title.
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/index.ts';

const s = t('ko');
---

<BaseLayout locale="ko">
  <div class="wrap">
    <div class="contents">
      <h1 class="cnt_title">{s.siteTitle}</h1>
      <p>{s.preparing}</p>
    </div>
  </div>
</BaseLayout>
