---
// English year pages /en/years/2016/ … /en/years/2026/.
import '../../../styles/global.css';
import YearPage from '../../../components/YearPage.astro';
import { YEARS } from '../../../lib/years.ts';

export function getStaticPaths() {
  return YEARS.map((year) => ({ params: { year: String(year) }, props: { year } }));
}

const { year } = Astro.props;
---

<YearPage year={year} locale="en" />
