---
// Sub page frame: the 250px visual band with the archive label, then inside the 1200px grid a 240px side area
// (the section's side navigation, or the year tab rail on year pages) and the 900px main column with the page
// heading, the breadcrumb and the page content.
import '../styles/edition.css';
import '../styles/archive-edition.css';
import '../styles/students-edition.css';
import { chapters } from '../lib/chapters.ts';
import { localePath } from '../lib/locale.ts';
import BaseLayout from './BaseLayout.astro';
import Snb from '../components/Snb.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import type { SectionKey } from '../lib/menu.ts';
import type { Locale } from '../lib/locale.ts';
import { url } from '../lib/url.ts';
import { t } from '../i18n/index.ts';

interface Props {
  title: string;
  /** Menu section of the page. Required for the side navigation (`side: 'menu'`); year pages have none. */
  sectionKey?: SectionKey;
  /** Site-root path of the current board (`/people/students/`), without the base or `/en`. */
  currentHref: string;
  locale: Locale;
  /** `menu` (default): the section's side navigation. `years`: the side area holds the `side` slot (year tabs). */
  side?: 'menu' | 'years';
}

const { title, sectionKey, currentHref, locale, side = 'menu' } = Astro.props;
if (side === 'menu' && !sectionKey) throw new Error(`SubLayout "${title}": side navigation needs a sectionKey`);
const s = t(locale);
const studentsEdition = currentHref === '/people/students/';
const alumniEdition = currentHref === '/people/alumni/';
const facultyEdition = currentHref === '/people/faculty/';
const peopleEdition = studentsEdition || alumniEdition || facultyEdition;
const archiveEdition = !peopleEdition;
const editionTitles: Record<string, string> = {publication:'Research in print.', award:'Milestones. Recognition.', project:'Ideas in progress.', activity:'Seminars. Shared ideas.', archive:'Our shared voices.', people:'People & discovery.'};
const chapter = chapters.find((entry) => entry.path === (side === 'years' ? '/years/' : currentHref));
---

<BaseLayout title={title} locale={locale} bodyClass={peopleEdition ? 'edition-board people-edition ' + (studentsEdition ? 'students-edition' : 'alumni-edition') : 'edition-board archive-edition'}>
  <slot name="opening" />
  {!Astro.slots.has('opening') && <div class="sub_visual" style={`background-image:url(${url('/images/site/sub_visual.jpg')})`}>
    <div class="wrap">
      {peopleEdition ? (
        <div class="students-cover">
          <div class="students-cover-copy">
            <p class="sub_visual-label">{s.archiveLabel}</p>
            <p class="edition-masthead" lang="en" aria-hidden="true">
              {facultyEdition ? <>Guiding minds.<br />Shared <em>discovery.</em></> : studentsEdition ? <>The people<br />behind <em>discovery.</em></> : <>Our paths.<br />One shared <em>story.</em></>}
            </p>
            <p class="students-masthead-note">{facultyEdition ? (locale === 'ko' ? '연구의 방향을 함께 만들어가는 교수진.' : 'The faculty guiding our shared research journey.') : studentsEdition
              ? (locale === 'ko' ? '함께 질문하고, 발견하고, 성장하는 사람들.' : 'People who question, discover and grow together.')
              : (locale === 'ko' ? '서로 다른 길에서도 이어지는 연구실의 인연.' : 'A shared journey, wherever life takes us.')}</p>
          </div>
          <slot name="cover" />
        </div>
      ) : (
        <>
          <p class="sub_visual-label">{s.archiveLabel}</p>
          <p class="edition-masthead" lang="en" aria-hidden="true">{chapter?.title ?? editionTitles[sectionKey ?? 'archive']}</p>
        </>
      )}
    </div>
  </div>
  }
  <div id="sub_contents" class="wrap">
    <div class="side">
      {side === 'menu' && sectionKey ? <Snb sectionKey={sectionKey} currentHref={currentHref} locale={locale} /> : <slot name="side" />}
    </div>
    <div class="contentBox">
      <div class="cnt_head">
        <h1 class="cnt_title">{title}</h1>
        <Breadcrumb sectionKey={sectionKey} title={title} locale={locale} />
      </div>
      <div class="contents">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
